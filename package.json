{
  "name": "live-arena",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Live Arena - jogo 2D automatico para TikTok LIVE",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "start:ws-test": "node server/server.js --ws-test",
    "start:live": "node --env-file-if-exists=.env server/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "python test/browser.py"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "tiktok-live-connector": "2.5.0",
    "ws": "8.22.0"
  }
}
